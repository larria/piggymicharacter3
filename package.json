{
    "name": "piggy-island",
    "version": "3.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite --host 0.0.0.0",
        "build": "tsc -b && vite build",
        "predeploy": "npm run build",
        "deploy": "gh-pages -d dist",
        "test": "vitest run",
        "cards:import": "node scripts/import-cards.mjs",
        "cards:sync": "node scripts/import-cards.mjs --sync",
        "test:cards": "node --test scripts/import-cards.node-test.mjs",
        "hanzi:import": "node scripts/import-hanzi.mjs",
        "test:hanzi": "node --test tests/hanzi-import.node-test.mjs"
    },
    "dependencies": {
        "canvas-confetti": "^1.9.4",
        "lucide-react": "^0.468.0",
        "react": "^19.1.0",
        "react-dom": "^19.1.0"
    },
    "devDependencies": {
        "@types/canvas-confetti": "^1.9.0",
        "@types/node": "^26.6.5",
        "@types/react": "^19.1.0",
        "@types/react-dom": "^19.1.0",
        "@vitejs/plugin-react": "^4.4.1",
        "gh-pages": "^6.3.0",
        "sharp": "^0.35.5",
        "typescript": "~5.8.3",
        "vite": "^6.3.5",
        "vitest": "^3.1.3"
    }
}
